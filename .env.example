# --- Модель Anthropic ---
# Ключ Anthropic API. Без него приложение работает в демо-режиме.
ANTHROPIC_API_KEY=
# Необязательно. Модель по умолчанию — claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# --- Стоимость запросов ---
# Глубина размышлений: low | medium | high | xhigh | max. По умолчанию medium.
# Замер на реальном брифе: high $0.289, medium $0.261, low $0.220.
ANTHROPIC_EFFORT=medium

# Необязательно. Модель для лёгких задач (извлечение текста резюме, письма,
# сравнение). По умолчанию — основная. claude-sonnet-5 дешевле примерно вдвое.
# ANTHROPIC_LIGHT_MODEL=claude-sonnet-5

# Потолок веб-поисков за один запрос. Каждый поиск стоит и сам по себе,
# и объёмом результатов, который оплачивается как вход на каждой итерации.
# 12 — настройка «глубокого поиска» (12–20 кандидатов, несколько углов).
# Поставьте 5, если нужен более дешёвый и быстрый лонг-лист: по замеру
# 5 поисков — примерно $0.16–0.27 за прогон.
WEB_SEARCH_MAX_USES=12
DOSSIER_SEARCH_MAX_USES=8

# --- Аккаунты и база (SaaS-режим) ---
# PostgreSQL для хранения пользователей и позиций. Если не задать —
# приложение работает в in-memory режиме (данные теряются при перезапуске,
# годится только для локальной проверки).
DATABASE_URL=postgres://user:password@host:5432/dbname
# Если провайдер требует TLS без проверки CA (обычно так у managed PG) —
# оставьте как есть. Чтобы полностью отключить TLS, поставьте: PGSSL=disable
# PGSSL=

# Секрет для подписи сессионных cookie. ОБЯЗАТЕЛЬНО задайте случайную строку
# в проде (например: openssl rand -hex 32). Без неё приложение в проде не
# стартует (защита от подделки сессий предсказуемым секретом).
SESSION_SECRET=

# Необязательно. Если задать — регистрация возможна только с этим кодом
# приглашения (защищает общий доступ по ссылке). Раздайте код своим рекрутёрам.
INVITE_CODE=

# Необязательно. Если задать — регистрироваться могут только адреса на этом
# домене. Напр.: ALLOWED_EMAIL_DOMAIN=eastmining.ru
ALLOWED_EMAIL_DOMAIN=

# Стартовые администраторы: e-mail через запятую. Эти пользователи видят
# админку всегда (даже без флага в базе) — с них назначаются остальные админы.
# Напр.: ADMIN_EMAILS=demeshkinaas@eastmining.ru
ADMIN_EMAILS=

# --- Интеграция с ATS «Поток Рекрутмент» ---
# Токен компании из Потока: Настройки компании → Генерация токенов.
# Если не задан — панель выгрузки в интерфейсе просто не показывается.
POTOK_TOKEN=
# Необязательно, по умолчанию https://app.potok.io/api/v3
# POTOK_BASE_URL=
